# Celliii Discord Companion Bot Environment Variables

# The bot token from the Discord Developer Portal
DISCORD_TOKEN=your_discord_token_here

# Google Gemini API Key for the AI chat addon
GEMINI_API_KEY=your_gemini_api_key_here

# Spotify API credentials (optional, but required for Spotify support in music addon)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Lavalink Server configuration (for music addon)
LAVALINK_URL=localhost:2333
LAVALINK_AUTH=youshallnotpass
